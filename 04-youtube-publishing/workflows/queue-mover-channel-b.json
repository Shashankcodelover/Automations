            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Copy to Publishing Folder B": {
      "main": [
        [
          {
            "node": "Delete from Queue Folder A",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
