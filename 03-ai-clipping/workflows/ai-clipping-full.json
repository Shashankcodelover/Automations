            { "name": "Content-Type", "value": "application/json" },
            { "name": "blotato-api-key", "value": "={{ $env.BLOTATO_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"post\": { \"accountId\": $env.INSTAGRAM_ACCOUNT_ID, \"content\": { \"text\": $('Compute Schedule').item.json.caption, \"mediaUrls\": [ $json.url ], \"platform\": \"instagram\" }, \"target\": { \"targetType\": \"instagram\", \"mediaType\": \"reel\" } }, \"scheduledTime\": $('Compute Schedule').item.json.scheduledTime } }}",
        "options": { "timeout": 30000 }
      },
      "id": "n17-instagram",
      "name": "Schedule Instagram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 1800, -120 ],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://backend.blotato.com/v2/posts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "blotato-api-key", "value": "={{ $env.BLOTATO_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"post\": { \"accountId\": $env.YOUTUBE_ACCOUNT_ID, \"content\": { \"text\": $('Compute Schedule').item.json.caption.slice(0,99), \"mediaUrls\": [ $json.url ], \"platform\": \"youtube\" }, \"target\": { \"targetType\": \"youtube\", \"title\": $('Compute Schedule').item.json.caption.slice(0,99), \"privacyStatus\": \"public\", \"shouldNotifySubscribers\": true, \"isMadeForKids\": false } }, \"scheduledTime\": $('Compute Schedule').item.json.scheduledTime } }}",
        "options": { "timeout": 30000 }
      },
      "id": "n18-youtube",
      "name": "Schedule YouTube",
