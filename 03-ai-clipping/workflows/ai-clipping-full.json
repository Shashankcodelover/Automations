      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [ 2100, -120 ],
      "credentials": { "googleSheetsOAuth2Api": { "id": "GOOGLE_SHEETS_CRED_ID", "name": "Google Sheets" } },
      "onError": "continueRegularOutput",
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Central error logger. Catch-all for error outputs.\nconst err = $json.error || $json;\nconsole.log('AI Clipping Automation error:', JSON.stringify(err));\nreturn [{ json: { failed_node: $json.node ? $json.node.name : 'unknown', error: err, timestamp: new Date().toISOString() } }];"
      },
      "id": "n20-errorlog",
      "name": "Log Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ 0, 200 ]
